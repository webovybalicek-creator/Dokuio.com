---
/**
 * „Před podpisem zkontrolujte“ + oficiální zdroje. Povinné u každé šablony (zadání: bezpečnost uživatele).
 * Odkazy v tipech ve tvaru [text](https://…).
 */
import { formatDatum } from '../sablony/dokument';
import type { Sablona } from '../sablony/typy';
import { texty } from '../i18n';
interface Props {
  sablona: Sablona;
  /** Kompaktní verze do průvodce */
  kompakt?: boolean;
}
const { sablona: s, kompakt = false } = Astro.props;
const T = texty(s.jazyk).kontrola;
const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const html = (t: string) =>
  esc(t).replace(/\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g, '<a href="$2" rel="noopener" target="_blank">$1</a>');
---

<div class:list={['kontrola', { 'kontrola--kompakt': kompakt }]}>
  <p class="kontrola__nadpis">
    <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M10 2.5 3.5 5v4.6c0 4 2.8 7 6.5 8 3.7-1 6.5-4 6.5-8V5z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="m7 10 2 2 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    {T.nadpis}
  </p>
  <ul class="kontrola__seznam">
    {s.kontrola.map((t) => <li set:html={html(t)} />)}
  </ul>
  <p class="kontrola__zdroje">
    {T.zdroje(formatDatum(s.overeno))}{' '}
    {s.zdroje.map((z, i) => <>{i > 0 && ' · '}<a href={z.url} rel="noopener" target="_blank">{z.nazev}</a></>)}
  </p>
</div>
