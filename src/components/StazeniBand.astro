---
/**
 * Pás se stažením na konci každé stránky dokumentu (požadavek ze zadání):
 * vždy jde stáhnout vlastní (vyplněná/upravená) verze i obecný prázdný vzor, v PDF i ve Wordu.
 * V průvodci (`pruvodce`) tlačítka „Vaše smlouva“ obsluhuje skript průvodce (data-stahnout).
 */
import type { Slovo } from '../sablony/typy';
import { texty } from '../i18n';
import Upozorneni from './Upozorneni.astro';
import EmailPdf from './EmailPdf.astro';

interface Props {
  nadpis: string;
  vzorPdf: string;
  vzorDocx: string;
  vytvorit?: string;
  pruvodce?: boolean;
  slovo?: Slovo;
  jazyk?: string;
  /** Název dokumentu do e-mailu */
  nazev?: string;
}
const { nadpis, vzorPdf, vzorDocx, vytvorit, pruvodce = false, slovo, jazyk, nazev } = Astro.props;
const TX = texty(jazyk);
const T = TX.stazeni;
const w = slovo ?? TX.slovo;
---

<section class="sekce stazeni" id="stazeni" aria-labelledby="stazeni-nadpis">
  <div class="wrap">
    <div class="ram sekce__in">
      <h2 id="stazeni-nadpis">{nadpis}{' '}<span>{T.span}</span></h2>
      <div class="dve-cesty">
        <div class="cesta cesta--hlavni">
          <h3>{pruvodce ? T.vase(w) : T.vyplnena(w)}</h3>
          <p>{pruvodce ? T.vasePopis(w) : T.vyplnenaPopis(w)}</p>
          {
            pruvodce ? (
              <div class="akce akce--tesne">
                <button type="button" class="btn btn--primarni" data-stahnout="pdf">{T.stahnoutPdf}</button>
                <button type="button" class="btn btn--duch" data-stahnout="docx">{T.stahnoutWord}</button>
              </div>
            ) : (
              <div class="akce akce--tesne">
                <a class="btn btn--primarni btn--sipka" href={vytvorit}>{TX.landing.vyplnitOnlineZdarma}</a>
              </div>
            )
          }
        </div>
        <div class="cesta">
          <h3>{T.prazdny}</h3>
          <p>{T.prazdnyPopis}</p>
          <div class="akce akce--tesne">
            <a class="btn btn--duch" href={vzorPdf} download>{T.vzorPdf}</a>
            <a class="btn btn--duch" href={vzorDocx} download>{T.vzorWord}</a>
          </div>
          <div class="stazeni__email" data-email-vzor={vzorPdf} data-nadpis={nazev ?? nadpis}>
            <EmailPdf jazyk={jazyk ?? 'cs'} />
          </div>
        </div>
      </div>
      <Upozorneni jazyk={jazyk} />
    </div>
  </div>
</section>

<script>
  import { napojEmail } from '../scripts/email-pdf';
  document.querySelectorAll<HTMLElement>('[data-email-vzor]').forEach((el) => {
    const url = el.dataset.emailVzor!;
    const soubor = url.split('/').pop()!.replace(/\.pdf$/, '');
    const zeme = location.pathname.split('/').filter(Boolean)[0] ?? 'cz';
    napojEmail(el.querySelector<HTMLElement>('[data-email-pdf]')!, () => fetch(url).then((r) => r.blob()), {
      jazyk: document.documentElement.lang,
      zeme,
      nazev: el.dataset.nadpis ?? soubor,
      soubor,
    });
  });
</script>
