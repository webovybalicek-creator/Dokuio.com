---
/** Formulář „Poslat PDF na e-mail“ – logiku napojí src/scripts/email-pdf.ts. */
import { texty } from '../i18n';
interface Props {
  jazyk: string;
}
const T = texty(Astro.props.jazyk).email;
const id = `email-pdf-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="email-pdf" data-email-pdf>
  <label class="email-pdf__nadpis" for={id}>
    <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><rect x="2.5" y="4.5" width="15" height="11" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"></rect><path d="m3.5 6 6.5 5 6.5-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path></svg>
    {T.nadpis}
  </label>
  <div class="email-pdf__radek">
    <input id={id} class="email-pdf__vstup" type="email" inputmode="email" autocomplete="email" placeholder={T.placeholder} data-email-adresa />
    <input class="email-pdf__past" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" data-email-past />
    <button type="button" class="btn btn--duch email-pdf__tl" data-email-odeslat>{T.odeslat}</button>
  </div>
  <p class="email-pdf__popis">{T.popis}</p>
  <p class="email-pdf__zprava" data-email-zprava role="status" hidden></p>
</div>
