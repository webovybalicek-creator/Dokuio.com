---
/**
 * Okno „Líbí se vám Dokuio?“ – ukáže se až po stažení smlouvy (nikdy předtím, nikdy jako podmínka).
 * Ano → podpora (Stripe: karta, Apple Pay, Google Pay; volitelně QR platba). Ne → jedna věta zpětné vazby.
 * Zavření = klid na PODPORA.pauzaDni dní (localStorage, jen v tomto prohlížeči).
 * Spouští se událostí `dokuio:stazeno` na window (průvodce) nebo kliknutím na odkaz s atributem download.
 */
import { PODPORA } from '../lib/config';
---

<dialog class="podpora" data-podpora data-stripe={PODPORA.stripe} data-iban={PODPORA.iban} data-prijemce={PODPORA.prijemce} data-castka={PODPORA.castkaKc} data-pauza={PODPORA.pauzaDni} aria-labelledby="podpora-nadpis">
  <button type="button" class="podpora__zavrit" data-podpora-zavrit aria-label="Zavřít">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
  </button>

  <div class="podpora__krok" data-krok="otazka">
    <svg class="podpora__logo" viewBox="0 0 48 48" width="40" height="40" aria-hidden="true"><path d="M14 6h16l-6 36H8z" fill="#533afd" fill-opacity=".9" /><path d="M24 6h12l-6 36H18z" fill="#9b5cff" fill-opacity=".9" /><path d="M34 6h8l-6 36h-8z" fill="#ff5fa2" fill-opacity=".95" /></svg>
    <h2 id="podpora-nadpis">Staženo. Líbí se vám Dokuio?</h2>
    <p>Vzory děláme zdarma pro všechny. Vaše odpověď nám pomůže.</p>
    <div class="podpora__volby">
      <button type="button" class="btn btn--primarni" data-podpora-ano>Ano, líbí</button>
      <button type="button" class="btn btn--duch" data-podpora-ne>Něco mi chybí</button>
    </div>
  </div>

  <div class="podpora__krok" data-krok="podpora" hidden>
    <h2>Děkujeme! Podpoříte provoz?</h2>
    <p>
      Malý příspěvek pokryje hosting a nové vzory, které zůstanou zdarma pro všechny.
      Jedno kafe stojí <strong>30&nbsp;Kč</strong> (1&nbsp;€, 1&nbsp;$). Počet si zvolíte v platbě.
    </p>
    <a class="btn btn--primarni btn--plna podpora__stripe" data-podpora-stripe href={PODPORA.stripe} target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M7 9h9v5a4 4 0 0 1-4 4h-1a4 4 0 0 1-4-4zM16 10h1.5a2 2 0 0 1 0 4H16M9 4.5c0 1 1 1 1 2M12 4.5c0 1 1 1 1 2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
      Koupit nám kafe
    </a>
    <p class="podpora__metody">Karta · Apple Pay · Google Pay · bezpečně přes Stripe</p>
    <div class="podpora__qr" data-podpora-qr hidden>
      <p class="podpora__qr-titulek">Nebo QR platbou z bankovní aplikace</p>
      <div class="podpora__qr-obr" data-podpora-qr-obr></div>
      <p class="podpora__metody">Naskenujte v mobilním bankovnictví, částku můžete změnit.</p>
    </div>
    <button type="button" class="odkaz-tl" data-podpora-zavrit>Teď ne</button>
  </div>

  <div class="podpora__krok" data-krok="vazba" hidden>
    <h2>Co bychom měli zlepšit?</h2>
    <p>Stačí jedna věta. Odpověď je anonymní.</p>
    <form data-podpora-form>
      <label class="sr-only" for="podpora-text">Co zlepšit</label>
      <textarea id="podpora-text" name="text" rows="3" maxlength="1000" required placeholder="Např. chyběla mi možnost…"></textarea>
      <div class="podpora__volby">
        <button type="submit" class="btn btn--primarni">Odeslat</button>
        <button type="button" class="odkaz-tl" data-podpora-zavrit>Zavřít</button>
      </div>
    </form>
  </div>

  <div class="podpora__krok" data-krok="dik" hidden>
    <h2>Děkujeme za zpětnou vazbu.</h2>
    <p>Každou odpověď čteme a podle nich web vylepšujeme.</p>
    <div class="podpora__volby">
      <button type="button" class="btn btn--duch" data-podpora-zavrit>Zavřít</button>
    </div>
  </div>
</dialog>

<script>
  import qrcode from 'qrcode-generator';

  const dlg = document.querySelector<HTMLDialogElement>('[data-podpora]');
  if (dlg) {
    const KLIC = 'dokuio:podpora';
    const pauzaDni = Number(dlg.dataset.pauza ?? 30);
    const kroky = [...dlg.querySelectorAll<HTMLElement>('[data-krok]')];
    const ukaz = (k: string) => kroky.forEach((el) => (el.hidden = el.dataset.krok !== k));

    const smiUkazat = () => {
      try {
        const posledni = Number(localStorage.getItem(KLIC) ?? 0);
        return Date.now() - posledni > pauzaDni * 864e5;
      } catch {
        return true;
      }
    };
    const zapamatuj = (dni = 0) => {
      try {
        localStorage.setItem(KLIC, String(Date.now() + dni * 864e5));
      } catch {
        /* bez úložiště se okno může ukázat znovu */
      }
    };

    // QR platba (SPAYD) jen když je vyplněný IBAN
    const iban = (dlg.dataset.iban ?? '').replace(/\s/g, '').toUpperCase();
    if (iban) {
      const zprava = 'PODPORA DOKUIO';
      const spayd = `SPD*1.0*ACC:${iban}*AM:${Number(dlg.dataset.castka ?? 30).toFixed(2)}*CC:CZK*RN:${(dlg.dataset.prijemce ?? '').toUpperCase()}*MSG:${zprava}`;
      const qr = qrcode(0, 'M');
      qr.addData(spayd);
      qr.make();
      dlg.querySelector<HTMLElement>('[data-podpora-qr-obr]')!.innerHTML = qr.createSvgTag({ cellSize: 4, margin: 2, scalable: true });
      dlg.querySelector<HTMLElement>('[data-podpora-qr]')!.hidden = false;
    }

    const otevri = () => {
      if (dlg.open || !smiUkazat()) return;
      ukaz('otazka');
      dlg.showModal();
    };
    const zavri = () => {
      dlg.close();
    };

    let navicDni = 0;
    dlg.addEventListener('close', () => zapamatuj(navicDni));
    dlg.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t === dlg) zavri(); // klik na pozadí
      else if (t.closest('[data-podpora-zavrit]')) zavri();
      else if (t.closest('[data-podpora-ano]')) ukaz('podpora');
      else if (t.closest('[data-podpora-ne]')) {
        ukaz('vazba');
        dlg.querySelector('textarea')?.focus();
      } else if (t.closest('[data-podpora-stripe]')) {
        // po odchodu na platbu okno zavřít a dát pokoj na déle
        navicDni = 60;
        setTimeout(() => dlg.close(), 300);
      }
    });

    dlg.querySelector<HTMLFormElement>('[data-podpora-form]')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const text = (new FormData(e.target as HTMLFormElement).get('text') ?? '').toString().trim();
      if (!text) return;
      try {
        await fetch('/zpetna-vazba.php', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({ text, stranka: location.pathname }),
        });
      } catch {
        /* zpětná vazba je dobrovolná – chybu nehlásit */
      }
      ukaz('dik');
    });

    // Spouštěče: průvodce vyšle událost po stažení; odkazy na prázdné vzory mají atribut download
    window.addEventListener('dokuio:stazeno', () => setTimeout(otevri, 900));
    document.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[download]');
      if (a) setTimeout(otevri, 1200);
    });
  }
</script>
