---
// Malé tematické ilustrace ke smlouvám ve výpisu – vlastní kresby v barvách webu
import type { Ilustrace } from '../obsah/typy';

interface Props {
  typ: Ilustrace;
}
const { typ } = Astro.props;
const id = `il-${typ}`;
---

<svg class="ilustrace" viewBox="0 0 64 64" aria-hidden="true">
  <defs>
    <linearGradient id={`${id}-pozadi`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#eef0ff" />
      <stop offset="1" stop-color="#fbe9f6" />
    </linearGradient>
    <linearGradient id={`${id}-akcent`} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#9d7bff" />
      <stop offset="1" stop-color="#ff5fa2" />
    </linearGradient>
  </defs>
  <rect width="64" height="64" rx="10" fill={`url(#${id}-pozadi)`} />
  <g fill="none" stroke="#533afd" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    {
      typ === 'auto' && (
        <>
          <path d="M14 38v-6l5-9h22l7 9h2a2 2 0 0 1 2 2v4" />
          <path d="M19 32h29M30 23v9" />
          <circle cx="22" cy="39" r="4" fill="#fff" />
          <circle cx="44" cy="39" r="4" fill="#fff" />
          <path d="M26 39h14M14 39h4M48 39h3" />
          <path d="M14 48h36" stroke={`url(#${id}-akcent)`} stroke-width="3" />
        </>
      )
    }
    {
      typ === 'motorka' && (
        <>
          <circle cx="18" cy="40" r="7" fill="#fff" />
          <circle cx="46" cy="40" r="7" fill="#fff" />
          <path d="M18 40l9-12h10l9 12M27 28l-3-5h-5M37 28l4-6h5M30 34h8" />
          <path d="M14 52h36" stroke={`url(#${id}-akcent)`} stroke-width="3" />
        </>
      )
    }
    {
      typ === 'protokol' && (
        <>
          <rect x="18" y="14" width="28" height="38" rx="3" fill="#fff" />
          <path d="M26 14v-2h12v2M24 26l3 3 5-6M36 27h5M24 37l3 3 5-6M36 38h5" />
          <path d="M24 46h16" stroke={`url(#${id}-akcent)`} stroke-width="3" />
        </>
      )
    }
    {
      typ === 'plnamoc' && (
        <>
          <path d="M18 12h20l8 8v32H18z" fill="#fff" />
          <path d="M38 12v8h8M24 26h16M24 32h16M24 38h8" />
          <path d="M34 50c3-4 6-6 8-4s-3 5 0 5 4-2 6-3" stroke={`url(#${id}-akcent)`} stroke-width="2.4" />
        </>
      )
    }
    {
      typ === 'dar' && (
        <>
          <rect x="16" y="28" width="32" height="22" rx="2" fill="#fff" />
          <rect x="13" y="21" width="38" height="8" rx="2" fill="#fff" />
          <path d="M32 21v29" />
          <path d="M32 21c-3-7-12-8-11-2 1 3 7 2 11 2zM32 21c3-7 12-8 11-2-1 3-7 2-11 2z" />
          <path d="M16 39h32" stroke={`url(#${id}-akcent)`} stroke-width="3" />
        </>
      )
    }
    {
      typ === 'penize' && (
        <>
          <rect x="12" y="22" width="40" height="22" rx="3" fill="#fff" />
          <circle cx="32" cy="33" r="5" />
          <path d="M18 28v0M46 38v0" stroke-width="3" />
          <path d="M16 50h32" stroke={`url(#${id}-akcent)`} stroke-width="3" />
        </>
      )
    }
    {
      typ === 'pujcka' && (
        <>
          <path d="M12 42h8l8 4h12a3 3 0 0 0 0-6h-8" />
          <path d="M20 40l6-4h8" />
          <circle cx="40" cy="22" r="8" fill="#fff" />
          <path d="M40 18v8M37.5 20h4a1.5 1.5 0 0 1 0 3h-3a1.5 1.5 0 0 0 0 3h4" stroke-width="1.6" />
          <path d="M12 52h40" stroke={`url(#${id}-akcent)`} stroke-width="3" />
        </>
      )
    }
    {
      typ === 'dluh' && (
        <>
          <path d="M16 12h22l8 8v30H16z" fill="#fff" />
          <path d="M38 12v8h8M22 26h14M22 32h10" />
          <circle cx="42" cy="44" r="8" fill="#fff" />
          <path d="M42 40v8M39 44h6" />
          <path d="M22 44h8" stroke={`url(#${id}-akcent)`} stroke-width="3" />
        </>
      )
    }
  </g>
</svg>
