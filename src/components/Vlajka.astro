---
// Vlajky jako SVG – emoji vlajky se na Windows zobrazují jen jako písmena („CZ“)
interface Props {
  kod: string;
}
const { kod } = Astro.props;
---

{
  kod === 'cz' && (
    <svg class="vlajka" viewBox="0 0 27 18" aria-hidden="true">
      <rect width="27" height="9" fill="#fff" />
      <rect y="9" width="27" height="9" fill="#d7141a" />
      <path d="M0 0l13.5 9L0 18z" fill="#11457e" />
    </svg>
  )
}
{
  kod === 'sk' && (
    <svg class="vlajka" viewBox="0 0 27 18" aria-hidden="true">
      <rect width="27" height="6" fill="#fff" />
      <rect y="6" width="27" height="6" fill="#0b4ea2" />
      <rect y="12" width="27" height="6" fill="#ee1c25" />
      <path d="M5.2 4.2h7.2v6.2c0 2.6-1.8 3.8-3.6 4.6-1.8-.8-3.6-2-3.6-4.6z" fill="#ee1c25" stroke="#fff" stroke-width=".6" />
      <path d="M8.8 6v6.6M7.3 7.6h3M6.8 9.2h4" stroke="#fff" stroke-width=".8" />
      <path d="M5.8 12.6c.8-.9 1.6-.9 2-.3.4-.6 1.2-.6 2 .3" fill="#0b4ea2" />
    </svg>
  )
}
{
  kod === 'pl' && (
    <svg class="vlajka" viewBox="0 0 27 18" aria-hidden="true">
      <rect width="27" height="9" fill="#fff" />
      <rect y="9" width="27" height="9" fill="#dc143c" />
      <rect width="27" height="18" fill="none" stroke="#e5edf5" stroke-width=".6" />
    </svg>
  )
}
{
  kod === 'de' && (
    <svg class="vlajka" viewBox="0 0 27 18" aria-hidden="true">
      <rect width="27" height="6" fill="#000" />
      <rect y="6" width="27" height="6" fill="#dd0000" />
      <rect y="12" width="27" height="6" fill="#ffce00" />
    </svg>
  )
}
{
  kod === 'at' && (
    <svg class="vlajka" viewBox="0 0 27 18" aria-hidden="true">
      <rect width="27" height="18" fill="#c8102e" />
      <rect y="6" width="27" height="6" fill="#fff" />
    </svg>
  )
}
{
  kod === 'ch' && (
    <svg class="vlajka" viewBox="0 0 27 18" aria-hidden="true">
      <rect width="27" height="18" fill="#da291c" />
      <rect x="11.75" y="4" width="3.5" height="10" fill="#fff" />
      <rect x="8.5" y="7.25" width="10" height="3.5" fill="#fff" />
    </svg>
  )
}
{
  kod === 'hu' && (
    <svg class="vlajka" viewBox="0 0 27 18" aria-hidden="true">
      <rect width="27" height="6" fill="#ce2939" />
      <rect y="6" width="27" height="6" fill="#fff" />
      <rect y="12" width="27" height="6" fill="#477050" />
    </svg>
  )
}
{
  kod === 'hr' && (
    <svg class="vlajka" viewBox="0 0 27 18" aria-hidden="true">
      <rect width="27" height="6" fill="#ff0000" />
      <rect y="6" width="27" height="6" fill="#fff" />
      <rect y="12" width="27" height="6" fill="#171796" />
      <path d="M10.5 4.5h6v6q0 2.2-3 3.2q-3-1-3-3.2z" fill="#fff" stroke="#171796" stroke-width="0.3" />
      <rect x="10.5" y="4.5" width="1.2" height="1.2" fill="#ff0000" />
      <rect x="12.9" y="4.5" width="1.2" height="1.2" fill="#ff0000" />
      <rect x="15.3" y="4.5" width="1.2" height="1.2" fill="#ff0000" />
      <rect x="11.7" y="5.7" width="1.2" height="1.2" fill="#ff0000" />
      <rect x="14.1" y="5.7" width="1.2" height="1.2" fill="#ff0000" />
      <rect x="10.5" y="6.9" width="1.2" height="1.2" fill="#ff0000" />
      <rect x="12.9" y="6.9" width="1.2" height="1.2" fill="#ff0000" />
      <rect x="15.3" y="6.9" width="1.2" height="1.2" fill="#ff0000" />
      <rect x="11.7" y="8.1" width="1.2" height="1.2" fill="#ff0000" />
      <rect x="14.1" y="8.1" width="1.2" height="1.2" fill="#ff0000" />
      <rect x="10.5" y="9.3" width="1.2" height="1.2" fill="#ff0000" />
      <rect x="12.9" y="9.3" width="1.2" height="1.2" fill="#ff0000" />
      <rect x="15.3" y="9.3" width="1.2" height="1.2" fill="#ff0000" />
    </svg>
  )
}
