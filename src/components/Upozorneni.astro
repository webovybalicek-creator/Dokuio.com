---
/**
 * Upozornění u stažení (zadání): za smlouvu odpovídá uživatel, doporučujeme kontrolu advokátem.
 */
interface Props {
  jazyk?: string;
}
const { jazyk = 'cs' } = Astro.props;
const T = {
  cs: {
    nadpis: 'Za smlouvu odpovídáte vy',
    text: 'Dokuio je bezplatný vzor k vyplnění, ne právní služba. Za obsah, úpravy a použití dokumentu odpovídáte sami. Před podpisem si ho pečlivě přečtěte a doporučujeme nechat ho zkontrolovat advokátem – zvlášť u vyšších částek, nájmu nebo nestandardní situace.',
  },
  sk: {
    nadpis: 'Za zmluvu zodpovedáte vy',
    text: 'Dokuio je bezplatný vzor na vyplnenie, nie právna služba. Za obsah, úpravy a použitie dokumentu zodpovedáte sami. Pred podpisom si ho pozorne prečítajte a odporúčame dať ho skontrolovať advokátovi – najmä pri vyšších sumách, nájme alebo neštandardnej situácii.',
  },
};
const t = jazyk === 'sk' ? T.sk : T.cs;
---

<div class="upozorneni" role="note">
  <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M10 2.8 1.8 17h16.4z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M10 8v4.2M10 14.6v.1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
  <p><strong>{t.nadpis}.</strong> {t.text}</p>
</div>
