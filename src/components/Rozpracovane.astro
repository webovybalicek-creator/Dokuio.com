---
/** „Rozpracované v tomto prohlížeči“ – seznam konceptů z localStorage (nic se neposílá na server). */
import { STRANKY, urlStranky } from '../obsah';
import type { StrankaDokumentu } from '../obsah/typy';
import { texty } from '../i18n';
interface Props {
  zeme: string;
  jazyk: string;
  /** Jazyková verze: dokumenty verze (kód šablony je stejný jako u originálu, koncept je společný) */
  stranky?: StrankaDokumentu[];
}
const { zeme, jazyk, stranky } = Astro.props;
const T = texty(jazyk).koncept;
const mapa = Object.fromEntries((stranky ?? STRANKY[zeme] ?? []).map((st) => [st.sablona.kod, { nazev: st.nazev, url: `${urlStranky(st)}vytvorit/` }]));
---

<div class="rozpracovane" data-rozpracovane data-mapa={JSON.stringify(mapa)} data-jazyk={jazyk} data-pokracovat={T.pokracovat} data-smazat={T.smazat} data-upraveno={T.upraveno('{kdy}')} hidden>
  <p class="rozpracovane__nadpis">{T.rozpracovaneNadpis} <span>{T.rozpracovaneSpan}</span></p>
  <ul></ul>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-rozpracovane]').forEach((box) => {
    const mapa = JSON.parse(box.dataset.mapa!) as Record<string, { nazev: string; url: string }>;
    const ul = box.querySelector('ul')!;
    const vyplneno = (d: Record<string, unknown> = {}) => Object.values(d).some((v) => (Array.isArray(v) ? v.length : String(v ?? '').trim()));
    let polozky: { klic: string; kod: string; kdy: string }[] = [];
    try {
      polozky = Object.keys(localStorage)
        .filter((k) => k.startsWith('dokuio:') && k.split(':').length === 3 && mapa[k.split(':')[1]])
        .map((k) => {
          const st = JSON.parse(localStorage.getItem(k)!);
          return vyplneno(st.data) ? { klic: k, kod: k.split(':')[1], kdy: st.ulozeno ?? '' } : null;
        })
        .filter((x): x is { klic: string; kod: string; kdy: string } => !!x)
        .sort((a, b) => b.kdy.localeCompare(a.kdy))
        .slice(0, 6);
    } catch {
      return;
    }
    if (!polozky.length) return;
    const loc = box.dataset.jazyk === 'cs' ? 'cs-CZ' : box.dataset.jazyk!;
    for (const p of polozky) {
      const li = document.createElement('li');
      const a = Object.assign(document.createElement('a'), { href: mapa[p.kod].url, textContent: mapa[p.kod].nazev });
      li.append(a);
      if (p.kdy) {
        const small = document.createElement('small');
        small.textContent = box.dataset.upraveno!.replace('{kdy}', new Date(p.kdy).toLocaleString(loc, { day: 'numeric', month: 'numeric', hour: '2-digit', minute: '2-digit' }));
        li.append(small);
      }
      const del = Object.assign(document.createElement('button'), { type: 'button', className: 'odkaz-tl', textContent: box.dataset.smazat! });
      del.addEventListener('click', () => {
        try {
          localStorage.removeItem(p.klic);
        } catch {}
        li.remove();
        if (!ul.children.length) box.hidden = true;
      });
      li.append(del);
      ul.append(li);
    }
    box.hidden = false;
  });
</script>
