---
/**
 * Landing stránka dokumentu (SEO + rozcestí): hero s náhledem vzoru, jak to funguje, obsah,
 * online vs. papír, pro koho je, co dál, FAQ (FAQPage JSON-LD), související dokumenty, stažení.
 */
import Base from '../layouts/Base.astro';
import Duvera from './Duvera.astro';
import StazeniBand from './StazeniBand.astro';
import Podpora from './Podpora.astro';
import Ilustrace from './Ilustrace.astro';
import Kontrola from './Kontrola.astro';
import type { StrankaDokumentu } from '../obsah/typy';
import { souvisejici as najdiSouvisejici, urlStranky, zemeKod } from '../obsah';
import { sestavDokument, formatDatum } from '../sablony/dokument';
import { dokumentHtml } from '../sablony/html';
import { SITE } from '../lib/config';
import { texty } from '../i18n';
import '../styles/dokument.css';

interface Props {
  stranka: StrankaDokumentu;
}
const { stranka } = Astro.props;
const s = stranka.sablona;
const zeme = zemeKod(s.zeme);
const TX = texty(s.jazyk);
const T = TX.landing;
const base = urlStranky(stranka);
const p = {
  ...stranka.landing,
  nazev: stranka.nazev,
  nazevA: stranka.nazevA,
  title: stranka.landing.title.replace('{rok}', s.aktualizovano.slice(0, 4)),
  souvisejici: najdiSouvisejici(s.zeme, stranka.souvisejici, base),
};
const vzorPdf = `${base}${s.souborPdf}-vzor.pdf`;
const vzorDocx = `${base}${s.souborPdf}-vzor.docx`;
const vytvorit = `${base}vytvorit/`;
const aktualizovano = formatDatum(s.aktualizovano);
const mesic = s.aktualizovano.slice(5, 7).replace(/^0/, '') + '/' + s.aktualizovano.slice(0, 4);
const nahled = dokumentHtml(sestavDokument(s, {}));
const RIMSKE = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X'];
const stitek = (i: number) => (s.cislovatClanky === false ? `${i + 1}.` : T.clanek(RIMSKE[i]));
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: `${p.nazev} – ${T.online}`,
    url: `${SITE.url}${base}`,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Any',
    inLanguage: s.jazyk,
    offers: { '@type': 'Offer', price: '0', priceCurrency: TX.mena.kod },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: p.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: zeme.nazev, item: `${SITE.url}/${zeme.kod}/` },
      { '@type': 'ListItem', position: 2, name: p.nazev, item: `${SITE.url}${base}` },
    ],
  },
];
---

<Base title={p.title} description={p.description} lang={s.jazyk}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
  <Fragment slot="nav">
    <a class="nav__odkaz" href="#jak-to-funguje">{T.jakToFunguje}</a>
    <a class="btn btn--primarni btn--maly btn--sipka" href={vytvorit}>{T.vyplnitZdarma}</a>
  </Fragment>

  <section class="hero hero--dokument">
    <div class="hero__vlna" aria-hidden="true"></div>
    <div class="wrap">
      <div class="ram hero__obsah hero__mrizka">
        <div>
          <nav class="drobecky" aria-label={TX.drobecky}><a href={`/${zeme.kod}/`}>{zeme.nazev}</a> › {p.nazev}</nav>
          <p class="horni-stitek">{T.stitek} · <span>{T.aktualizovano} {mesic}</span></p>
          <h1>{p.nazev}{' '}<span>{p.perex}</span></h1>
          <div class="akce">
            <a class="btn btn--primarni btn--sipka" href={vytvorit}>{T.vyplnitOnlineZdarma}</a>
            <a class="btn btn--duch" href={vzorPdf} download>{T.stahnoutPrazdny}</a>
          </div>
          <Duvera class="duvera--hero" lang={s.jazyk} />
        </div>
        <figure class="nahled-vzoru">
          <div class="papir papir--orez" set:html={nahled} />
          <figcaption>{T.nahledVzoru(s.kod, s.verze)}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="sekce" id="jak-to-funguje" aria-labelledby="jak-nadpis">
    <div class="wrap">
      <div class="ram sekce__in">
        <h2 id="jak-nadpis">{T.krokyNadpis}{' '}<span>{T.krokySpan}</span></h2>
        <ol class="kroky">
          {
            p.kroky.map((k) => (
              <li>
                <h3>{k.nazev}</h3>
                <p>{k.popis}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="sekce" aria-labelledby="obsah-nadpis">
    <div class="wrap">
      <div class="ram sekce__in">
        <h2 id="obsah-nadpis">{T.obsahNadpis}{' '}<span>{p.obsahPopis}</span></h2>
        <ul class="mrizka">
          {
            p.obsah.map((o, i) => (
              <li>
                <div class="karta">
                  <span class="karta__cislo">{stitek(i)}</span>
                  <h3>{o.nazev}</h3>
                  <p>{o.popis}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="sekce" aria-labelledby="proc-nadpis">
    <div class="wrap">
      <div class="ram sekce__in">
        <h2 id="proc-nadpis">{T.cestyNadpis}{' '}<span>{T.cestySpan}</span></h2>
        <div class="dve-cesty">
          <div class="cesta cesta--hlavni">
            <h3>{T.online}</h3>
            <ul class="fajfky">{p.online.map((t) => <li>{t}</li>)}</ul>
            <a class="btn btn--primarni btn--sipka" href={vytvorit}>{T.vyplnitOnlineZdarma}</a>
          </div>
          <div class="cesta">
            <h3>{T.prazdny}</h3>
            <ul class="fajfky">{T.prazdnyBody.map((t) => <li>{t}</li>)}</ul>
            <div class="akce akce--tesne">
              <a class="btn btn--duch" href={vzorPdf} download>PDF</a>
              <a class="btn btn--duch" href={vzorDocx} download>Word</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="sekce" aria-labelledby="pouziti-nadpis">
    <div class="wrap">
      <div class="ram sekce__in">
        <h2 id="pouziti-nadpis">{T.pouzitiNadpis}{' '}<span>{T.pouzitiSpan}</span></h2>
        <div class="dve-cesty">
          <div class="cesta">
            <h3>{T.hodiSe}</h3>
            <ul class="fajfky">{p.hodiSe.map((t) => <li>{t}</li>)}</ul>
          </div>
          <div class="cesta cesta--tlumena">
            <h3>{T.nehodiSe}</h3>
            <ul class="krizky">{p.nehodiSe.map((t) => <li>{t}</li>)}</ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="sekce" aria-labelledby="kontrola-nadpis">
    <div class="wrap">
      <div class="ram sekce__in">
        <h2 id="kontrola-nadpis">{T.kontrolaNadpis}{' '}<span>{T.kontrolaSpan}</span></h2>
        <Kontrola sablona={s} />
      </div>
    </div>
  </section>

  <section class="sekce" aria-labelledby="po-nadpis">
    <div class="wrap">
      <div class="ram sekce__in">
        <h2 id="po-nadpis">{p.poNadpis ?? T.poNadpis}{' '}<span>{T.poSpan}</span></h2>
        <ol class="kroky">
          {
            p.po.map((k) => (
              <li>
                <h3>{k.nazev}</h3>
                <p>{k.popis}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  {
    p.souvisejici && p.souvisejici.length > 0 && (
      <section class="sekce" aria-labelledby="souvisejici-nadpis">
        <div class="wrap">
          <div class="ram sekce__in">
            <h2 id="souvisejici-nadpis">{T.souvisejiciNadpis}{' '}<span>{p.souvisejiciPopis ?? T.souvisejiciSpan}</span></h2>
            <ul class="vypis souvisejici">
              {p.souvisejici.map((d) => (
                <li>
                  <a class="vypis__polozka" href={d.url}>
                    <Ilustrace typ={d.ilustrace} />
                    <span class="vypis__text">
                      <strong>{d.nazev}</strong>
                      <span>{d.popis}</span>
                    </span>
                    <span class="vypis__stitek">{TX.hledani.zdarma}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )
  }

  <section class="sekce" aria-labelledby="faq-nadpis">
    <div class="wrap">
      <div class="ram sekce__in">
        <h2 id="faq-nadpis">{T.faq}</h2>
        <div class="faq">
          {
            p.faq.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
        <p class="poznamka">
          {p.zakony} {T.pata(s.kod, s.verze, aktualizovano)}
        </p>
      </div>
    </div>
  </section>

  <StazeniBand
    nadpis={T.stahnete(p.nazevA)}
    vytvorit={vytvorit}
    vzorPdf={vzorPdf}
    vzorDocx={vzorDocx}
    slovo={s.slovo}
    jazyk={s.jazyk}
  />
  <Podpora jazyk={s.jazyk} />
</Base>
