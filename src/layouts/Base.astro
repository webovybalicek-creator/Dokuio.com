---
import { JAZYKY_VERZI, TEXTY, type Jazyk } from '../i18n';
import '@fontsource-variable/inter-tight';
import '../styles/global.css';
import { SITE } from '../lib/config';
import { ogSlug } from '../lib/og';
import { INFO_ODKAZY } from '../obsah/informace';
import Souhlas from '../components/Souhlas.astro';
import { PORADNY } from '../lib/poradna';
import { ZEME } from '../obsah';

interface Props {
  title: string;
  description: string;
  lang?: string;
  noindex?: boolean;
  /** Jazykové verze téže stránky (hreflang) – jen tam, kde jde opravdu o stejný obsah */
  alternates?: { hreflang: string; href: string }[];
  /** Vlastní náhledový obrázek (absolutní URL), jinak vygenerovaný /og/… */
  obrazek?: string;
  /** Jazyková verze stránky země (uk, en): <html lang> = uk-CZ, og:locale jazyka, bez poradny */
  jazykVerze?: string;
}

const { title, description, lang = 'en', noindex = false, alternates = [], obrazek, jazykVerze } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const robots = !SITE.indexovat || noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1';
const ogImage = obrazek ?? new URL(`/og/${ogSlug(Astro.url.pathname)}.png`, SITE.url).href;
const P = TEXTY[lang as Jazyk]?.paticka;
const zemeCesty = Astro.url.pathname.split('/').filter(Boolean)[0] ?? '';
// Jazyk a locale podle země v cestě (de-AT, de-CH…), ne jen podle jazyka rozhraní
const zemeStranky = ZEME.find((z) => z.kod === zemeCesty);
// Jazyková verze: jazyk verze + region země (uk-CZ); og:locale bere jen platné dvojice Open Graph (uk_UA, en_GB)
const verze = jazykVerze ? JAZYKY_VERZI[jazykVerze] : undefined;
const htmlLang = verze && zemeStranky ? `${verze.hreflang}-${zemeStranky.hreflang.split('-')[1]}` : (zemeStranky?.hreflang ?? lang);
const ogLocale = verze ? verze.ogLocale : zemeStranky ? zemeStranky.hreflang.replace('-', '_') : (P?.ogLocale ?? 'en_US');
const zemeKodPaticky = INFO_ODKAZY[zemeCesty] ? zemeCesty : ({ sk: 'sk', pl: 'pl', de: 'de', hu: 'hu', hr: 'hr', sl: 'si', ro: 'ro', bg: 'bg', el: 'gr', et: 'ee', lv: 'lv', lt: 'lt' } as Record<string, string>)[lang] ?? 'cz';
// Poradna se nepřekládá – na stránkách jazykových verzí se nezobrazuje (PREKLADY.md)
const poradna = verze ? undefined : PORADNY[zemeKodPaticky];
const odkazy = INFO_ODKAZY[zemeCesty] ?? INFO_ODKAZY[({ sk: 'sk', pl: 'pl', de: 'de', hu: 'hu', hr: 'hr', sl: 'si', ro: 'ro', bg: 'bg', el: 'gr', et: 'ee', lv: 'lv', lt: 'lt' } as Record<string, string>)[lang] ?? 'cz'];
// Značku přidat jen tam, kde se titulek vejde do ~60 znaků (Google delší ořízne)
const fullTitle = title.includes(SITE.nazev) || title.length > 50 ? title : `${title} | ${SITE.nazev}`;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <!-- ověření Seznam Webmaster (účet fischer.vlada@gmail.com) – nemazat -->
    <meta name="seznam-wmt" content="Wlrl09VqnKO9l83VuUuYRwfVNT6qmori" />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={new URL(a.href, SITE.url).href} />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.nazev} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {
      ['/', '/cz/', '/sk/'].includes(Astro.url.pathname) && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify([
            {
              '@context': 'https://schema.org',
              '@type': 'Organization',
              name: 'Dokuio',
              url: SITE.url,
              logo: new URL('/apple-touch-icon.png', SITE.url).href,
              email: SITE.email,
            },
            {
              '@context': 'https://schema.org',
              '@type': 'WebSite',
              name: 'Dokuio',
              url: SITE.url,
              inLanguage: ['en', 'cs', 'sk'],
            },
          ])}
        />
      )
    }
    <slot name="head" />
  </head>
  <body>
    <header class="nav">
      <div class="wrap nav__in">
        <a class="logo" href="/" aria-label="Dokuio">
          <svg viewBox="0 0 48 48" width="28" height="28" aria-hidden="true"><path d="M14 6h16l-6 36H8z" fill="#533afd" fill-opacity=".9"/><path d="M24 6h12l-6 36H18z" fill="#9b5cff" fill-opacity=".9"/><path d="M34 6h8l-6 36h-8z" fill="#ff5fa2" fill-opacity=".95"/></svg>
          dokuio
        </a>
        <nav class="nav__odkazy">
          <slot name="nav" />
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="paticka">
      <div class="wrap paticka__in">
        <span>
          © {new Date().getFullYear()} {SITE.nazev} ·{' '}
          {P?.vse ?? 'All templates free as PDF and Word, no sign-up.'}
        </span>
        <p class="paticka__disclaimer">
          {P?.disclaimer ?? 'We provide templates free of charge and in good faith as a public service. This is not legal advice. You are solely responsible for the content, changes and use of any contract – read it carefully before signing and consult a lawyer in complex situations.'}
        </p>
        <nav class="paticka__odkazy" aria-label="Informace">
          {poradna && <a href={`/${zemeKodPaticky}/${poradna.slug}/`}>{poradna.nazev}</a>}
          <a href={odkazy.onas}>{P?.oNas ?? 'About'}</a>
          <a href={odkazy.podminky}>{P?.podminky ?? 'Terms'}</a>
          <a href={odkazy.ochrana}>{P?.ochrana ?? 'Privacy'}</a>
          {SITE.ga && <a href="#" data-cookies>{P?.cookies ?? 'Cookies'}</a>}
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </nav>
        <slot name="paticka" />
      </div>
    </footer>
    <Souhlas lang={lang} ochrana={odkazy.ochrana} />
  </body>
</html>
