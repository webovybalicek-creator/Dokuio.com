---
import '@fontsource-variable/inter-tight';
import '../styles/global.css';
import { SITE } from '../lib/config';

interface Props {
  title: string;
  description: string;
  lang?: string;
  noindex?: boolean;
}

const { title, description, lang = 'en', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const robots = !SITE.indexovat || noindex ? 'noindex, follow' : 'index, follow';
const fullTitle = title.includes(SITE.nazev) ? title : `${title} | ${SITE.nazev}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.nazev} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <slot name="head" />
  </head>
  <body>
    <header class="nav">
      <div class="wrap nav__in">
        <a class="logo" href="/" aria-label="Dokuio">
          <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M6 2.75h8.25L19 7.5v13.75H6z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M14 2.75V7.5h5M9.5 12.5h6M9.5 16h4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          Dokuio
        </a>
        <nav class="nav__odkazy">
          <slot name="nav" />
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="paticka">
      <div class="wrap paticka__in">
        <span>
          © {new Date().getFullYear()} {SITE.nazev} ·{' '}
          {lang === 'cs'
            ? 'Všechny vzory zdarma ve formátu PDF i Word, bez registrace.'
            : lang === 'sk'
              ? 'Všetky vzory zadarmo vo formáte PDF aj Word, bez registrácie.'
              : 'All templates free as PDF and Word, no sign-up.'}
        </span>
        <p class="paticka__disclaimer">
          {
            lang === 'cs'
              ? 'Vzory poskytujeme zdarma a v dobré víře jako službu pro veřejnost. Nejde o právní poradenství. Za obsah, úpravy a použití smlouvy odpovídá výhradně uživatel – před podpisem si ji pečlivě přečtěte a u složitějších situací se poraďte s advokátem.'
              : lang === 'sk'
                ? 'Vzory poskytujeme zadarmo a v dobrej viere ako službu pre verejnosť. Nejde o právne poradenstvo. Za obsah, úpravy a použitie zmluvy zodpovedá výlučne používateľ – pred podpisom si ju pozorne prečítajte a pri zložitejších situáciách sa poraďte s advokátom.'
                : 'We provide templates free of charge and in good faith as a public service. This is not legal advice. You are solely responsible for the content, changes and use of any contract – read it carefully before signing and consult a lawyer in complex situations.'
          }
        </p>
        <slot name="paticka" />
      </div>
    </footer>
  </body>
</html>
