---
import Base from '../layouts/Base.astro';
import { ZEME } from '../lib/config';

const kroky = [
  { nazev: 'Choose a document', popis: 'Pick the contract you need, for example a car sale agreement.' },
  { nazev: 'Answer a few questions', popis: 'A short guided form asks only what matters and explains every question.' },
  { nazev: 'Download the PDF', popis: 'Your contract is ready to print and sign. No account needed.' },
];
---

<Base
  title="Dokuio – contracts and documents made easy"
  description="Fill in a few questions and download a ready-to-sign contract as a PDF. Templates follow the law of your country."
>
  <section class="hero wrap">
    <span class="stitek">Coming soon</span>
    <h1>Contracts and documents, <span>made easy.</span></h1>
    <p>
      Answer a few simple questions and download a ready-to-sign PDF. Every template follows the law of your
      country.
    </p>
    <div class="akce">
      <a class="btn btn--primarni" href="#countries">Choose your country</a>
      <a class="btn btn--duch" href="#how-it-works">How it works</a>
    </div>
  </section>

  <section class="sekce wrap" id="countries" aria-labelledby="countries-title">
    <div class="sekce__hlava">
      <span class="stitek">Countries</span>
      <h2 id="countries-title">Built for local law</h2>
      <p>Contracts differ from country to country, so every country gets its own set of templates.</p>
    </div>
    <ul class="mrizka">
      {
        ZEME.map((z) => (
          <li>
            <a class="karta" href={`/${z.kod}/`} hreflang={z.jazyk}>
              <h3>
                {z.vlajka} {z.nazev}
              </h3>
              <p>{z.nazevEn}</p>
              <span class="odkaz-sipka">Open</span>
            </a>
          </li>
        ))
      }
      <li>
        <div class="karta karta--tlumena">
          <h3>More countries</h3>
          <p>On the way.</p>
        </div>
      </li>
    </ul>
  </section>

  <section class="sekce wrap" id="how-it-works" aria-labelledby="how-title">
    <div class="sekce__hlava">
      <span class="stitek">How it works</span>
      <h2 id="how-title">Three steps to a finished contract</h2>
    </div>
    <ol class="kroky">
      {
        kroky.map((k) => (
          <li>
            <h3>{k.nazev}</h3>
            <p>{k.popis}</p>
          </li>
        ))
      }
    </ol>
    <p class="poznamka">
      Dokuio provides document templates to fill in. It is not legal advice; for complex situations, consult a
      lawyer.
    </p>
  </section>
</Base>
