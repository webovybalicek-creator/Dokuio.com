---
import Base from '../layouts/Base.astro';
import Vlajka from '../components/Vlajka.astro';
import Duvera from '../components/Duvera.astro';
import { AKTIVNI_ZEME as ZEME } from '../obsah';
import { HREFLANG_ROZCESTNIKU as HREFLANG_HUBY } from '../preklady';

// Směrování podle polohy: Česko → /cz/, Slovensko → /sk/.
// Poloha z časové zóny zařízení (bez IP a bez cookies), záložně z jazyka prohlížeče.
// Nepřesměrovává, když uživatel přišel z jiné stránky webu nebo zvolil „Jiná země“ (?zeme=…),
// takže si zemi může vždy vybrat ručně. Roboti vyhledávačů (časová zóna USA) zůstanou na rozcestníku.
const zony = Object.fromEntries(ZEME.map((z) => [z.casovaZona, z.kod]));
const jazyky = Object.fromEntries([...ZEME].reverse().map((z) => [z.jazyk, z.kod])); // první země s daným jazykem vyhrává (de → Německo)
const geoSkript = `(function(){try{
if(/[?&]zeme=/.test(location.search))return;
if(document.referrer&&new URL(document.referrer).host===location.host)return;
var z=${JSON.stringify(zony)},j=${JSON.stringify(jazyky)};
var tz=(Intl.DateTimeFormat().resolvedOptions().timeZone)||'';
var k=z[tz];
if(!k){var l=(navigator.languages||[navigator.language||'']);for(var i=0;i<l.length&&!k;i++){k=j[String(l[i]).slice(0,2).toLowerCase()];}}
if(k)location.replace('/'+k+'/');
}catch(e){}})();`;

const ALIASY: Record<string, string> = {
  cz: 'czech republic cesko čechy tschechien czechy česká republika',
  sk: 'slovakia slowakei słowacja slovensko',
  pl: 'poland polen polsko poľsko',
  de: 'germany německo nemecko niemcy',
  at: 'austria rakousko rakúsko austria österreich osterreich',
  hu: 'hungary maďarsko maďarsko węgry ungarn magyarország magyarorszag',
  hr: 'croatia chorvatsko chorvátsko chorwacja kroatien horvátország hrvatska',
  si: 'slovenia slovinsko slovinsko słowenia slowenien szlovénia slovenija',
  ro: 'romania rumunsko rumunsko rumunia rumänien románia rumunjska romunija românia',
  gr: 'greece recko grecko grecja griechenland görögország grcka grcija grecia гърция ελλαδα ελλάδα hellas',
  bg: 'bulgaria bulharsko bulharsko bulgaria bulgarien bulgária bugarska bolgarija bulgaria българия',
  ch: 'switzerland švýcarsko švajčiarsko szwajcaria suisse svizzera',
};

const kroky = [
  { nazev: 'Choose a document', popis: 'Pick the contract you need, for example a car sale agreement.' },
  { nazev: 'Answer a few questions', popis: 'A short guided form asks only what matters and explains every question.' },
  { nazev: 'Download PDF or Word', popis: 'Free and ready to print and sign. No account needed.' },
];
---

<Base
  alternates={HREFLANG_HUBY}
  title="Dokuio – contracts and documents made easy"
  description="Free contract templates as PDF and Word. Answer a few questions and download a ready-to-sign contract that follows the law of your country."
>
  <script slot="head" is:inline set:html={geoSkript} />
  <Fragment slot="nav">
    <a class="nav__odkaz" href="#how-it-works">How it works</a>
    <a class="btn btn--primarni btn--maly btn--sipka" href="#countries">Choose country</a>
  </Fragment>

  <section class="hero">
    <div class="hero__vlna" aria-hidden="true"></div>
    <div class="wrap">
      <div class="ram hero__obsah">
        <p class="horni-stitek">Free · PDF and Word · <span>{ZEME.length} countries</span></p>
        <h1>
          Free contract templates, <em>ready as PDF.</em>{' '}
          <span>Answer a few simple questions and download a ready-to-sign contract that follows the law of your country.</span>
        </h1>
        <div class="akce">
          <a class="btn btn--primarni btn--sipka" href="#countries">Choose your country</a>
          <a class="btn btn--duch" href="#how-it-works">How it works</a>
        </div>
        <Duvera lang="en" class="duvera--hero" />
      </div>
    </div>
  </section>

  <section class="sekce" id="countries" aria-labelledby="countries-title">
    <div class="wrap">
      <div class="ram sekce__in sekce__in--tesne">
        <h2 id="countries-title">
          Choose your country.{' '}<span>Every country gets its own templates, written for local law.</span>
        </h2>
        <label class="hledani__pole zeme-hledani">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
          <input type="search" id="zeme-hledat" placeholder="Search country" autocomplete="off" aria-label="Search country" />
        </label>
        <ul class="zeme-mrizka" id="zeme-seznam">
          {
            ZEME.map((z) => (
              <li data-hledat={`${z.nazev} ${z.nazevEn} ${ALIASY[z.kod] ?? ''}`.toLowerCase()}>
                <a class="zeme-polozka" href={`/${z.kod}/`} hreflang={z.jazyk}>
                  <Vlajka kod={z.kod} />
                  <strong>{z.nazev}</strong>
                  <span>{z.nazevEn}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="zeme-nic" id="zeme-nic" hidden>This country is not available yet. More countries are on the way.</p>
        <p class="zeme-dalsi">More countries on the way.</p>
        <script is:inline>
          (function () {
            var i = document.getElementById('zeme-hledat'), polozky = document.querySelectorAll('#zeme-seznam li'), nic = document.getElementById('zeme-nic');
            if (!i) return;
            var bez = function (t) { return t.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, ''); };
            i.addEventListener('input', function () {
              var q = bez(i.value.trim()), n = 0;
              polozky.forEach(function (li) { var ok = !q || bez(li.dataset.hledat).indexOf(q) > -1; li.hidden = !ok; if (ok) n++; });
              nic.hidden = n > 0;
            });
            i.addEventListener('keydown', function (e) {
              if (e.key !== 'Enter') return;
              var prvni = document.querySelector('#zeme-seznam li:not([hidden]) a');
              if (prvni) location.href = prvni.href;
            });
          })();
        </script>
      </div>
    </div>
  </section>

  <section class="sekce" id="how-it-works" aria-labelledby="how-title">
    <div class="wrap">
      <div class="ram sekce__in">
        <h2 id="how-title">Three steps to a finished contract.{' '}<span>No account, no lawyer jargon.</span></h2>
        <ol class="kroky">
          {
            kroky.map((k) => (
              <li>
                <h3>{k.nazev}</h3>
                <p>{k.popis}</p>
              </li>
            ))
          }
        </ol>
        <p class="poznamka">
          Dokuio provides document templates to fill in. It is not legal advice; for complex situations, consult
          a lawyer.
        </p>
      </div>
    </div>
  </section>
</Base>
