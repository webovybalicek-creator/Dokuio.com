---
import { HREFLANG_HUBY } from '../../lib/config';
import Base from '../../layouts/Base.astro';
import Duvera from '../../components/Duvera.astro';
import Hledani from '../../components/Hledani.astro';

const kroky = [
  { nazev: 'Najděte smlouvu', popis: 'Napište, co řešíte – třeba „prodej auta“ – a vyberte dokument.' },
  { nazev: 'Odpovězte na otázky', popis: 'Průvodce se ptá jen na podstatné. Text smlouvy můžete upravit nebo zkrátit.' },
  { nazev: 'Stáhněte PDF nebo Word', popis: 'Zdarma a bez registrace. Nebo si stáhněte prázdný vzor a vyplňte ho rukou.' },
];
---

<Base
  alternates={HREFLANG_HUBY}
  title="Vzory smluv zdarma v PDF – vyplňte online"
  description="Vzory smluv zdarma podle českého práva: kupní smlouva na auto, darovací smlouva, půjčka, plná moc. Vyplňte online, stáhněte PDF nebo Word."
  lang="cs"
>
  <Fragment slot="nav">
    <a class="nav__odkaz" href="#jak-to-funguje">Jak to funguje</a>
    <a class="btn btn--duch btn--maly" href="/?zeme=vyber" hreflang="en">Jiná země</a>
  </Fragment>

  <section class="hero">
    <div class="hero__vlna" aria-hidden="true"></div>
    <div class="wrap">
      <div class="ram hero__obsah hero__obsah--hledani">
        <p class="horni-stitek">Česko · <span>smlouvy podle českého práva</span></p>
        <h1>
          Vzory smluv <em>zdarma v PDF.</em>{' '}
          <span>Vyplňte online za pár minut, nebo si stáhněte prázdný vzor. I ve Wordu, bez registrace.</span>
        </h1>
        <Duvera class="duvera--hero" />
      </div>
    </div>
  </section>

  <section class="sekce" id="smlouvy" aria-labelledby="smlouvy-nadpis">
    <div class="wrap">
      <div class="ram sekce__in sekce__in--tesne">
        <h2 id="smlouvy-nadpis">Jakou smlouvu potřebujete?{' '}<span>Hledejte podle situace, ne podle paragrafů.</span></h2>
        <Hledani zeme="cz" />
      </div>
    </div>
  </section>

  <section class="sekce" id="jak-to-funguje" aria-labelledby="jak-nadpis">
    <div class="wrap">
      <div class="ram sekce__in">
        <h2 id="jak-nadpis">Tři kroky ke hotové smlouvě.{' '}<span>Bez registrace a bez právnické hantýrky.</span></h2>
        <ol class="kroky">
          {
            kroky.map((k) => (
              <li>
                <h3>{k.nazev}</h3>
                <p>{k.popis}</p>
              </li>
            ))
          }
        </ol>
        <p class="poznamka">
          Dokuio poskytuje vzory dokumentů k vyplnění, nejde o právní poradenství. U složitějších situací
          doporučujeme obrátit se na advokáta.
        </p>
      </div>
    </div>
  </section>
</Base>
