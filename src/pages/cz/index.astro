---
import Base from '../../layouts/Base.astro';

// Plánované dokumenty pro Česko – jednoduché smlouvy mezi soukromými osobami
const dokumenty = [
  { nazev: 'Kupní smlouva na auto', popis: 'Prodej ojetého vozidla mezi soukromými osobami.', prvni: true },
  { nazev: 'Předávací protokol k vozidlu', popis: 'Stav vozu, klíče a doklady při předání.' },
  { nazev: 'Darovací smlouva', popis: 'Darování movité věci nebo peněz.' },
  { nazev: 'Smlouva o zápůjčce', popis: 'Půjčka peněz mezi známými, včetně splátek.' },
  { nazev: 'Plná moc', popis: 'Zmocnění někoho, aby vyřídil věc za vás.' },
  { nazev: 'Potvrzení o převzetí peněz', popis: 'Doklad o předání hotovosti.' },
];

const kroky = [
  { nazev: 'Vyberte dokument', popis: 'Najděte smlouvu, kterou potřebujete, třeba kupní smlouvu na auto.' },
  { nazev: 'Odpovězte na otázky', popis: 'Průvodce se ptá jen na to podstatné a u každé otázky vysvětlí, co znamená.' },
  { nazev: 'Stáhněte PDF', popis: 'Hotová smlouva je připravená k tisku a podpisu, bez registrace.' },
];
---

<Base
  title="Smlouvy a dokumenty snadno"
  description="Odpovězte na pár otázek a stáhněte si hotovou smlouvu v PDF podle českého práva."
  lang="cs"
>
  <Fragment slot="nav">
    <a class="nav__odkaz" href="#jak-to-funguje">Jak to funguje</a>
    <a class="btn btn--duch btn--maly" href="/" hreflang="en">Jiná země</a>
  </Fragment>

  <section class="hero">
    <div class="hero__vlna" aria-hidden="true"></div>
    <div class="wrap">
      <div class="ram hero__obsah">
        <p class="horni-stitek">Česko: <span>připravujeme první dokumenty</span></p>
        <h1>
          Smlouvy a dokumenty <em>snadno a rychle.</em>{' '}
          <span>Odpovězte na pár jednoduchých otázek a stáhněte si hotovou smlouvu v PDF podle českého práva.</span>
        </h1>
        <div class="akce">
          <a class="btn btn--primarni btn--sipka" href="#dokumenty">Prohlédnout dokumenty</a>
          <a class="btn btn--duch" href="#jak-to-funguje">Jak to funguje</a>
        </div>
      </div>
    </div>
  </section>

  <section class="sekce" id="dokumenty" aria-labelledby="dokumenty-nadpis">
    <div class="wrap">
      <div class="ram sekce__in">
        <h2 id="dokumenty-nadpis">
          Na čem pracujeme.{' '}<span>Začínáme jednoduchými smlouvami, které lidé potřebují nejčastěji.</span>
        </h2>
        <ul class="mrizka">
          {
            dokumenty.map((d) => (
              <li>
                <div class="karta">
                  {d.prvni && <span class="karta__znacka">Jako první</span>}
                  <h3>{d.nazev}</h3>
                  <p>{d.popis}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="sekce" id="jak-to-funguje" aria-labelledby="jak-nadpis">
    <div class="wrap">
      <div class="ram sekce__in">
        <h2 id="jak-nadpis">Tři kroky ke hotové smlouvě.{' '}<span>Bez registrace a bez právnické hantýrky.</span></h2>
        <ol class="kroky">
          {
            kroky.map((k) => (
              <li>
                <h3>{k.nazev}</h3>
                <p>{k.popis}</p>
              </li>
            ))
          }
        </ol>
        <p class="poznamka">
          Dokuio poskytuje vzory dokumentů k vyplnění, nejde o právní poradenství. U složitějších situací
          doporučujeme obrátit se na advokáta.
        </p>
      </div>
    </div>
  </section>
</Base>
