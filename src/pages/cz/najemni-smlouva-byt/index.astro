---
import DokumentLanding from '../../../components/DokumentLanding.astro';
import { najemniSmlouvaByt as s } from '../../../sablony/cz/najemni-smlouva-byt';
import { bydleniKrome } from '../../../lib/souvisejici';
const base = '/cz/najemni-smlouva-byt/';
---

<DokumentLanding
  sablona={s}
  base={base}
  nazev="Nájemní smlouva na byt"
  nazevA="nájemní smlouvu na byt"
  title={`Nájemní smlouva na byt ${s.aktualizovano.slice(0, 4)} – vzor PDF zdarma`}
  description="Nájemní smlouva na byt zdarma podle občanského zákoníku: nájemné, zálohy na služby, kauce, inflační doložka, doba určitá i neurčitá. PDF i Word."
  perex="Pronajímáte nebo si najímáte byt? Smlouva hlídá zákonné limity (kauce, drobné opravy, zvyšování nájemného) a nic, co by zákon zakazoval."
  obsahPopis="Osm článků podle § 2235 a násl. občanského zákoníku, ověřeno s materiály Veřejného ochránce práv a příručkou podpořenou MMR."
  obsah={[
    { nazev: 'Smluvní strany', popis: 'Pronajímatel a nájemce, kontakty.' },
    { nazev: 'Předmět nájmu', popis: 'Byt, číslo jednotky, dispozice, plocha, příslušenství, vybavení, počet osob.' },
    { nazev: 'Doba nájmu a předání', popis: 'Určitá nebo neurčitá doba, předání s protokolem.' },
    { nazev: 'Nájemné a služby', popis: 'Nájemné, zálohy, energie, splatnost, vyúčtování, inflační doložka.' },
    { nazev: 'Jistota', popis: 'Kauce do trojnásobku nájemného, úroky, vrácení.' },
    { nazev: 'Práva a povinnosti', popis: 'Drobné opravy podle nařízení vlády, úpravy bytu, podnájem, zvířata.' },
    { nazev: 'Skončení nájmu', popis: 'Dohoda, uplynutí doby, výpověď podle zákona, odevzdání bytu.' },
    { nazev: 'Závěrečná ustanovení', popis: 'Dva stejnopisy, dodatky, podpisy.' },
  ]}
  kroky={[
    { nazev: 'Odpovězte na otázky', popis: 'Byt, doba, nájemné, služby a kauce. Průvodce hlídá zákonné limity.' },
    { nazev: 'Zkontrolujte vlastníka', popis: 'Nahlížení do katastru nemovitostí je zdarma.' },
    { nazev: 'Podepište a předejte byt', popis: 'Dva výtisky a předávací protokol s měřiči.' },
  ]}
  online={['Kauce a drobné opravy v zákonných mezích', 'Správně formulovaná inflační doložka', 'Navazující předávací protokol předvyplníme', 'Stažení v PDF i ve Wordu']}
  hodiSe={['pronajímáte vlastní byt k bydlení', 'najímáte si byt od soukromého majitele', 'chcete férovou smlouvu bez neplatných ujednání']}
  nehodiSe={['podnájem (nájemce dává byt dál) – připravujeme podnájemní smlouvu', 'nebytový prostor, kancelář nebo garáž – jiná pravidla', 'krátkodobé ubytování (Airbnb) – nejde o nájem bytu']}
  poNadpis="Po podpisu."
  po={[
    { nazev: 'Předávací protokol', popis: 'Stavy měřičů, vady, klíče a fotky.' },
    { nazev: 'Kauce proti potvrzení', popis: 'Převodem nebo s písemným potvrzením o převzetí.' },
    { nazev: 'Energie a trvalý pobyt', popis: 'Přepis elektřiny a plynu; pokud chce nájemce trvalý pobyt, nájemní smlouva stačí jako doklad.' },
  ]}
  faq={[
    { q: 'Jak vysoká může být kauce?', a: 'Jistota spolu s případnou smluvní pokutou nesmí přesáhnout trojnásobek měsíčního nájemného (bez záloh na služby). Nájemci z ní náleží úroky.' },
    { q: 'Může pronajímatel zvyšovat nájemné?', a: 'Ano, pokud se strany dohodnou (např. inflační doložka s konkrétním ukazatelem ČSÚ). Bez dohody může pronajímatel navrhnout zvýšení nejvýš o 20 % za tři roky a nájemce musí do dvou měsíců souhlasit, jinak rozhoduje soud.' },
    { q: 'Jaké opravy platí nájemce?', a: 'Jen běžnou údržbu a drobné opravy podle nařízení vlády č. 308/2015 Sb. – ročně do 100 Kč za m² podlahové plochy, jednotlivá oprava mimo výčet do 1 000 Kč. Ostatní platí pronajímatel.' },
    { q: 'Musí být nájemní smlouva písemná?', a: 'Měla by. Pronajímatel ale nemůže zpochybnit platnost smlouvy jen proto, že nebyla písemná. Písemná smlouva je hlavní důkaz o tom, na čem jste se dohodli.' },
    { q: 'Jak může nájem skončit?', a: 'Dohodou, uplynutím sjednané doby nebo výpovědí. Pronajímatel může vypovědět jen ze zákonných důvodů a s poučením o právu nájemce na přezkum soudem.' },
    { q: 'Ukládáte moje údaje?', a: 'Ne. Smlouva se skládá přímo ve vašem prohlížeči.' },
  ]}
  zakony="Vzor vychází z § 2201 a násl. a § 2235 a násl. zákona č. 89/2012 Sb., občanský zákoník, nařízení vlády č. 308/2015 Sb. a zákona č. 67/2013 Sb.; ověřeno s letákem Veřejného ochránce práv „Nájem bytu“ a příručkou „Jak pronajmout byt?“ (Iuridicum Remedium, s podporou MMR)."
  souvisejiciPopis="Další dokumenty k bydlení, také zdarma."
  souvisejici={bydleniKrome(base)}
/>
