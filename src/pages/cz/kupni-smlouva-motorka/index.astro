---
import DokumentLanding from '../../../components/DokumentLanding.astro';
import { kupniSmlouvaMotorka as s } from '../../../sablony/cz/kupni-smlouva-motorka';
import { autoKrome } from '../../../lib/souvisejici';
const base = '/cz/kupni-smlouva-motorka/';
---

<DokumentLanding
  sablona={s}
  base={base}
  nazev="Kupní smlouva na motorku"
  nazevA="kupní smlouvu na motorku"
  title={`Kupní smlouva na motorku ${s.aktualizovano.slice(0, 4)} – vzor PDF zdarma`}
  description="Kupní smlouva na motorku, skútr nebo čtyřkolku zdarma: vyplňte online za 3 minuty, nebo stáhněte vzor v PDF i Wordu. Bez registrace."
  perex="Na prodej motocyklu, skútru, mopedu nebo čtyřkolky mezi soukromými osobami. Vyplňte online, nebo stáhněte prázdný vzor."
  obsahPopis="Stejných šest článků jako u auta, podle § 2079 a násl. občanského zákoníku."
  obsah={[
    { nazev: 'Smluvní strany', popis: 'Jméno, datum narození a adresa prodávajícího i kupujícího.' },
    { nazev: 'Vozidlo', popis: 'Značka a typ, VIN, SPZ, rok výroby, číslo osvědčení o registraci.' },
    { nazev: 'Stav vozidla', popis: 'Stav tachometru, známé vady a prohlášení o havárii.' },
    { nazev: 'Cena a platba', popis: 'Kupní cena číslem i slovy, hotovost nebo převod.' },
    { nazev: 'Předání a přepis', popis: 'Datum předání, klíče, doklady a kdo podá přepis.' },
    { nazev: 'Závěrečná ustanovení', popis: 'Dva stejnopisy a podpisy.' },
  ]}
  kroky={[
    { nazev: 'Odpovězte na otázky', popis: 'Co nevíte, přeskočte – zůstane linka k ručnímu doplnění.' },
    { nazev: 'Zkontrolujte motorku', popis: 'VIN na rámu, historie kilometrů na kontrolatachometru.cz, doklady.' },
    { nazev: 'Stáhněte a podepište', popis: 'PDF nebo Word zdarma, dva výtisky.' },
  ]}
  online={['Částka slovy se dopočítá sama', 'Kontrola VIN', 'Každý odstavec můžete upravit', 'Navazující předávací protokol a plná moc']}
  hodiSe={['prodáváte nebo kupujete motorku, skútr, moped či čtyřkolku od soukromé osoby', 'vozidlo je zapsané v registru vozidel', 'chcete mít písemně cenu, stav a předání']}
  nehodiSe={['kupujete od autobazaru nebo dealera (mají vlastní smlouvu)', 'jde o motorku bez technického průkazu (např. pitbike) – pak použijte kupní smlouvu na věc', 'motorka je na leasing nebo úvěr']}
  po={[
    { nazev: 'Podepište dva stejnopisy', popis: 'Každá strana si nechá jeden.' },
    { nazev: 'Předejte motorku a doklady', popis: 'Ideálně s předávacím protokolem.' },
    { nazev: 'Přepis do 10 pracovních dnů', popis: 'Na registru vozidel; kdo nejde osobně, dá plnou moc s ověřeným podpisem. Prodávající vypoví povinné ručení.' },
  ]}
  faq={[
    { q: 'Je smlouva na motorku jiná než na auto?', a: 'Právně ne – obojí je kupní smlouva na motorové vozidlo. Liší se jen praktické věci: VIN je vyražený na rámu, výbava a doplňky (kufry, výfuk) se vyplatí zapsat.' },
    { q: 'Hodí se i na skútr nebo moped?', a: 'Ano, na každé vozidlo zapsané v registru vozidel. Na pitbike nebo dětskou motorku bez technického průkazu použijte kupní smlouvu na věc.' },
    { q: 'Do kdy musím motorku přepsat?', a: 'Žádost o zápis změny vlastníka se podává do 10 pracovních dnů od převodu vlastnictví, jinak hrozí pokuta.' },
    { q: 'Ukládáte moje údaje?', a: 'Ne. Smlouva se skládá přímo ve vašem prohlížeči a údaje se na server neodesílají.' },
  ]}
  zakony="Vzor vychází ze zákona č. 89/2012 Sb., občanský zákoník (§ 2079 a násl.), a zákona č. 56/2001 Sb., o podmínkách provozu vozidel na pozemních komunikacích."
  souvisejici={autoKrome(base)}
/>
