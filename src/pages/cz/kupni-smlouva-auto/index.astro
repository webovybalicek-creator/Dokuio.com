---
import DokumentLanding from '../../../components/DokumentLanding.astro';
import { kupniSmlouvaAuto as s } from '../../../sablony/cz/kupni-smlouva-auto';
import { autoKrome } from '../../../lib/souvisejici';

const base = '/cz/kupni-smlouva-auto/';
---

<DokumentLanding
  sablona={s}
  base={base}
  nazev="Kupní smlouva na auto"
  nazevA="kupní smlouvu na auto"
  title={`Kupní smlouva na auto ${s.aktualizovano.slice(0, 4)} – vzor PDF zdarma`}
  description="Kupní smlouva na auto zdarma: vyplňte online za 3 minuty, nebo stáhněte prázdný vzor. PDF i Word, bez registrace, podle občanského zákoníku."
  perex="Vyplňte online za 3 minuty, nebo si stáhněte prázdný vzor. Pro prodej ojetého auta mezi soukromými osobami."
  obsahPopis="Šest článků podle § 2079 a násl. občanského zákoníku, bez zbytečných kliček."
  obsah={[
    { nazev: 'Smluvní strany', popis: 'Jméno, datum narození a adresa prodávajícího i kupujícího.' },
    { nazev: 'Vozidlo', popis: 'Značka a typ, VIN, SPZ, rok výroby, číslo osvědčení o registraci a technického průkazu.' },
    { nazev: 'Stav vozidla', popis: 'Stav tachometru, známé vady a prohlášení o havárii.' },
    { nazev: 'Cena a platba', popis: 'Kupní cena číslem i slovy, platba v hotovosti nebo převodem, okamžik přechodu vlastnictví.' },
    { nazev: 'Předání a přepis', popis: 'Datum předání, klíče a doklady, kdo podá žádost o přepis v registru vozidel.' },
    { nazev: 'Závěrečná ustanovení', popis: 'Dva stejnopisy, účinnost a podpisy obou stran.' },
  ]}
  kroky={[
    { nazev: 'Odpovězte na otázky', popis: 'Průvodce se ptá jen na to podstatné. Co nevíte, přeskočte – zůstane linka k ručnímu doplnění.' },
    { nazev: 'Upravte text, pokud chcete', popis: 'Každý odstavec můžete přepsat nebo smazat. Původní znění jde vždy vrátit jedním klikem.' },
    { nazev: 'Stáhněte PDF nebo Word', popis: 'Zdarma a bez registrace. Vytiskněte dvakrát a obě strany podepíší.' },
  ]}
  online={[
    'Částka slovy se dopočítá sama',
    'Kontrola VIN, nic nezapomenete',
    'Každý odstavec můžete upravit nebo smazat',
    'Stažení v PDF k podpisu i ve Wordu',
  ]}
  hodiSe={[
    'prodáváte nebo kupujete ojeté auto od soukromé osoby',
    'vůz je ve vašem vlastnictví a není na leasing',
    'chcete mít písemně cenu, stav vozu a datum předání',
  ]}
  nehodiSe={[
    'prodáváte firmě nebo autobazaru (mívají vlastní smlouvu)',
    'auto je na leasing nebo zastavené kvůli úvěru',
    'auto darujete – použijte darovací smlouvu',
  ]}
  po={[
    { nazev: 'Podepište dva stejnopisy', popis: 'Každá strana si nechá jeden podepsaný výtisk.' },
    { nazev: 'Předejte vůz a doklady', popis: 'Klíče, osvědčení o registraci a další doklady podle smlouvy. Stav při předání zapište do předávacího protokolu.' },
    { nazev: 'Zajistěte přepis', popis: 'Žádost o změnu vlastníka v registru vozidel podejte do 10 pracovních dnů. Kdo nepůjde osobně, dá druhému plnou moc s ověřeným podpisem. Kupující potřebuje povinné ručení od převzetí vozu.' },
  ]}
  faq={[
    { q: 'Je kupní smlouva na auto opravdu zdarma?', a: 'Ano. Vyplnění online i stažení v PDF a ve Wordu je zdarma a bez registrace. Nemusíte zadávat ani e-mail.' },
    { q: 'Musí být smlouva o prodeji auta písemná?', a: 'Zákon u prodeje auta mezi soukromými osobami písemnou formu nevyžaduje. Písemná smlouva je ale důkaz o tom, co jste si dohodli: cena, stav vozu, vady a datum předání. Proto ji doporučujeme vždy.' },
    { q: 'Kolik výtisků smlouvy potřebuji?', a: 'Dva stejnopisy. Každá strana si nechá jeden, oba podepsané prodávajícím i kupujícím.' },
    { q: 'Můžu text smlouvy upravit?', a: 'Ano. V průvodci můžete libovolný odstavec přepsat nebo smazat a přidat vlastní ustanovení. Vždy vycházíte z našeho základu a původní znění jde vrátit. Ve stažené verzi pro Word můžete upravit úplně všechno.' },
    { q: 'Co když se po prodeji objeví vada?', a: 'Odpovědnost za vady se řídí občanským zákoníkem. Do smlouvy proto pravdivě popište známé vady a stav tachometru. Na vady, o kterých kupující při koupi věděl, se reklamace nevztahuje.' },
    { q: 'Ukládáte moje údaje?', a: 'Ne. Smlouva se skládá přímo ve vašem prohlížeči a údaje se na server neodesílají. Rozpracovanou smlouvu si prohlížeč pamatuje jen u vás a můžete ji kdykoli smazat.' },
    { q: 'Hodí se smlouva i pro prodej firmě nebo autobazaru?', a: 'Vzor je určený pro prodej mezi dvěma soukromými osobami. Při prodeji firmě, autobazaru nebo vozu na leasing či úvěr použijte smlouvu druhé strany nebo se poraďte s advokátem.' },
  ]}
  zakony="Vzor vychází ze zákona č. 89/2012 Sb., občanský zákoník (§ 2079 a násl.) a zákona č. 56/2001 Sb., o podmínkách provozu vozidel na pozemních komunikacích."
  souvisejici={autoKrome(base)}
/>
