---
import { HREFLANG_HUBY } from '../../lib/config';
import Base from '../../layouts/Base.astro';
import Duvera from '../../components/Duvera.astro';
import Hledani from '../../components/Hledani.astro';

const kroky = [
  { nazev: 'Nájdite zmluvu', popis: 'Napíšte, čo riešite – napríklad „predaj auta“ – a vyberte dokument.' },
  { nazev: 'Odpovedzte na otázky', popis: 'Sprievodca sa pýta len na podstatné. Text zmluvy môžete upraviť alebo skrátiť.' },
  { nazev: 'Stiahnite PDF alebo Word', popis: 'Zadarmo a bez registrácie. Alebo si stiahnite prázdny vzor a vyplňte ho rukou.' },
];
---

<Base
  alternates={HREFLANG_HUBY}
  title="Vzory zmlúv zadarmo v PDF – vyplňte online"
  description="Vzory zmlúv zadarmo podľa slovenského práva pripravujeme: kúpna zmluva na auto, splnomocnenie, darovacia zmluva. PDF aj Word, bez registrácie."
  lang="sk"
>
  <Fragment slot="nav">
    <a class="nav__odkaz" href="#ako-to-funguje">Ako to funguje</a>
    <a class="btn btn--duch btn--maly" href="/?zeme=vyber" hreflang="en">Iná krajina</a>
  </Fragment>

  <section class="hero">
    <div class="hero__vlna" aria-hidden="true"></div>
    <div class="wrap">
      <div class="ram hero__obsah hero__obsah--hledani">
        <p class="horni-stitek">Slovensko · <span>pripravujeme prvé zmluvy podľa slovenského práva</span></p>
        <h1>
          Vzory zmlúv <em>zadarmo v PDF.</em>{' '}
          <span>Vyplňte online za pár minút alebo si stiahnite prázdny vzor. Aj vo Worde, bez registrácie.</span>
        </h1>
        <Duvera
          class="duvera--hero"
          polozky={['Zadarmo', 'PDF aj Word', 'Bez registrácie', 'Údaje zostávajú vo vašom prehliadači']}
        />
      </div>
    </div>
  </section>

  <section class="sekce" id="zmluvy" aria-labelledby="zmluvy-nadpis">
    <div class="wrap">
      <div class="ram sekce__in sekce__in--tesne">
        <h2 id="zmluvy-nadpis">Akú zmluvu potrebujete?{' '}<span>Prvé slovenské zmluvy pripravujeme.</span></h2>
        <Hledani zeme="sk" />
      </div>
    </div>
  </section>

  <section class="sekce" id="ako-to-funguje" aria-labelledby="ako-nadpis">
    <div class="wrap">
      <div class="ram sekce__in">
        <h2 id="ako-nadpis">Tri kroky k hotovej zmluve.{' '}<span>Bez registrácie a bez právnickej hatlaniny.</span></h2>
        <ol class="kroky">
          {
            kroky.map((k) => (
              <li>
                <h3>{k.nazev}</h3>
                <p>{k.popis}</p>
              </li>
            ))
          }
        </ol>
        <p class="poznamka">
          Dokuio poskytuje vzory dokumentov na vyplnenie, nejde o právne poradenstvo. Pri zložitejších situáciách
          odporúčame obrátiť sa na advokáta.
        </p>
      </div>
    </div>
  </section>
</Base>
