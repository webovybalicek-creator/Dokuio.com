---
import Base from '../../layouts/Base.astro';
---

<Base title="Děkujeme za podporu" description="Děkujeme, že podporujete Dokuio – vzory smluv zdarma pro všechny." lang="cs" noindex>
  <Fragment slot="nav">
    <a class="btn btn--duch btn--maly" href="/cz/">Zpět na smlouvy</a>
  </Fragment>
  <section class="hero">
    <div class="hero__vlna" aria-hidden="true"></div>
    <div class="wrap">
      <div class="ram hero__obsah">
        <p class="horni-stitek">Platba proběhla · <span>potvrzení vám přišlo e-mailem</span></p>
        <h1>Děkujeme, <em>moc to pomáhá.</em>{' '}<span>Díky vám zůstanou vzory smluv zdarma pro všechny a můžeme přidávat nové.</span></h1>
        <div class="akce">
          <a class="btn btn--primarni btn--sipka" href="/cz/">Zpět na smlouvy</a>
          <a class="btn btn--duch" href="/sk/">Slovenské zmluvy</a>
        </div>
      </div>
    </div>
  </section>
</Base>
